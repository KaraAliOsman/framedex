# Search scope only: these files remain versioned and usable by tools/tests.
# Read a known file directly, or use rg --no-ignore PATTERN SPECIFIC_DIRECTORY.
# Current source, test code, migrations, PRD and domain wiki stay searchable.

# Generated contract/client: start API changes at backend views/serializers.
/backend/openapi.yaml
/frontend/src/api/generated/

# Regression truth: keep test code visible; open payloads for a specific case.
/engine/tests/golden_*.json

# Dated payloads: open a specific file when a case needs it.
/docs/ai/evals/*.json
/docs/wiki/log.md
