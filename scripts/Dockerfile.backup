FROM postgres:17-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-venv \
    && rm -rf /var/lib/apt/lists/* \
    && python3 -m venv /opt/backup \
    && /opt/backup/bin/pip install --no-cache-dir psycopg[binary]==3.3.5 cryptography==50.0.1 httpx==0.28.1
ENV PATH=/opt/backup/bin:$PATH
WORKDIR /app
COPY scripts/backup_database.py scripts/restore_drill.sh /app/scripts/
USER postgres
ENTRYPOINT ["python", "scripts/backup_database.py"]
