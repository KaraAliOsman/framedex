{
  "name": "dekopen-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "dev": "vite",
    "lint": "eslint . --max-warnings 0 && tsc --noEmit",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "api:generate": "orval --config orval.config.ts && prettier --write \"src/api/generated/**/*.ts\"",
    "build": "vite build"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.112.4",
    "@tanstack/react-query": "5.102.8",
    "posthog-js": "1.422.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "7.18.3",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "eslint": "10.9.1",
    "jsdom": "30.0.1",
    "orval": "8.27.0",
    "otpauth": "9.5.1",
    "prettier": "3.9.6",
    "tailwindcss": "3.4.19",
    "typescript": "5.6.3",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
