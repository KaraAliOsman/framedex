# nginx:alpine renders this file with envsubst at container start.
# PORT — public listener port (Railway injects it).
# BACKEND_ORIGIN — fully-resolved private origin of the API service,
# e.g. http://api.railway.internal:8000 (envsubst does not recurse — no $VARS).
server {
    listen ${PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    location /api/ {
        proxy_pass ${BACKEND_ORIGIN}/api/;
        proxy_http_version 1.1;
        # Django validates Host against ALLOWED_HOSTS — send the upstream's own
        # authority (the BACKEND_ORIGIN host), not the frontend's public domain.
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Authorization $http_authorization;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
